# Copy to .env (gitignored). Everything works without these; features fall back as noted.
GEMINI_API_KEY=            # explainer; without it alerts use canned explanations
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=        # spoken alerts; without it the browser's own voice speaks them
ELEVENLABS_VOICE_CALM=     # voice id for warnings
ELEVENLABS_VOICE_URGENT=   # voice id for critical alerts
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=       # voice assistant (see docs/voice-agent.md)
